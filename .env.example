NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key for admin APIs (never use NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=
# Optional secret for protected background worker calls (server-side only)
STUDYPILOT_WORKER_SECRET=
# Optional external monitoring webhook. Leave empty until Sentry/log-drain/webhook is configured.
STUDYPILOT_MONITORING_WEBHOOK_URL=
STUDYPILOT_ENVIRONMENT=development
STUDYPILOT_RELEASE=local
# Allowed values: gemini, nvidia, auto
AI_PROVIDER=auto
AI_PROVIDER_TIMEOUT_MS=30000
# Summary synthesis can use a faster provider/model independently of chat and quiz.
SUMMARY_AI_PROVIDER=auto
SUMMARY_AI_TIMEOUT_MS=120000
SUMMARY_NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA Vision provider (separate from text model) for PDF/image vision fallback
# Use a vision-capable model (VILA is NVIDIA's vision-language model)
NVIDIA_VISION_API_KEY=
NVIDIA_VISION_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# Web search provider (server-side only)
TAVILY_API_KEY=
